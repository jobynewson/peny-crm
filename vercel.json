{
  "crons": [
    { "path": "/api/reminders?type=deliverables", "schedule": "0 9 * * *" },
    { "path": "/api/reminders?type=notes", "schedule": "0 21 * * *" },
    { "path": "/api/reminders?type=expense-digest", "schedule": "0 9 * * *" },
    { "path": "/api/reminders?type=task-nudge", "schedule": "0 14 * * *" },
    { "path": "/api/reminders?type=alerts", "schedule": "0 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/offloads", "destination": "/api/portal?view=offloads" },
    { "source": "/api/tasks",              "destination": "/api/portal?view=tasks&route=tasks" },
    { "source": "/api/tasks/(.*)",         "destination": "/api/portal?view=tasks&route=tasks/$1" },
    { "source": "/api/notifications",      "destination": "/api/portal?view=tasks&route=notifications" },
    { "source": "/api/notifications/(.*)", "destination": "/api/portal?view=tasks&route=notifications/$1" },
    { "source": "/api/retainers/(.*)",     "destination": "/api/retainers?route=retainers/$1" },
    { "source": "/api/companies/(.*)",     "destination": "/api/companies?route=companies/$1" },
    { "source": "/api/training/(.*)",      "destination": "/api/training?route=training/$1" },
    { "source": "/api/office-videos/(.*)", "destination": "/api/office-videos?route=office-videos/$1" },
    { "source": "/api/pdf-documents/(.*)", "destination": "/api/pdf-documents?route=pdf-documents/$1" },
    { "source": "/api/client/(.*)",        "destination": "/api/client?route=client/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard.html" },
    { "source": "/track/(.*)", "destination": "/track.html" },
    { "source": "/portal", "destination": "/portal.html" },
    { "source": "/portal/(.*)", "destination": "/portal.html" },
    { "source": "/call/(.*)", "destination": "/callsheet.html" },
    { "source": "/pack/(.*)", "destination": "/packing.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
